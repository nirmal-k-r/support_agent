# Copy to .env and fill in values (never commit the real .env).
DATABASE_URL=postgres://user:password@host:5432/dbname
PYTHON_API_URL=https://support-agent-zkz4.onrender.com
SESSION_DAYS=7

# Email (Resend). Free tier: https://resend.com — set key to enable sending.
# Without it, approvals log the email instead of sending (no errors).
RESEND_API_KEY=
SUPPORT_FROM_EMAIL=My Support <onboarding@resend.dev>


# Used by scripts/seed.mjs to create initial staff accounts.
ADMIN_EMAIL=admin@mysupport.app
ADMIN_PASSWORD=change-me-admin
OFFICER_EMAIL=officer@mysupport.app
OFFICER_PASSWORD=change-me-officer
